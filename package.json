{
  "name": "smartbolashaq-ide",
  "version": "1.5.0",
  "description": "Smart Bolashaq IDE — учебная среда Arduino с защищённым шаблоном кода и методическими материалами",
  "main": "main.js",
  "author": "Smart Bolashaq <info@smartbolashaq.kz>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "codemirror": "5.65.16",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "jsdom": "^29.1.1"
  },
  "build": {
    "appId": "kz.smartbolashaq.ide",
    "productName": "Smart Bolashaq IDE",
    "artifactName": "SmartBolashaqIDE-Setup-${version}.${ext}",
    "files": [
      "**/*",
      "!test/**",
      "!cloud-repo-example/**",
      "!build-resources/**",
      "!dist/**",
      "!*.zip",
      "!*.log"
    ],
    "extraResources": [
      {
        "from": "build-resources/arduino-cli",
        "to": "arduino-cli"
      },
      {
        "from": "build-resources/arduino-data",
        "to": "arduino-data"
      },
      {
        "from": "build-resources/arduino-user",
        "to": "arduino-user"
      },
      {
        "from": "resources/template.json",
        "to": "template.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Smart Bolashaq IDE"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "smartbolashaq",
        "repo": "smartbolashaq-ide"
      }
    ]
  }
}